rules_version = '2';

// Valise — правила за Firestore.
// Копирај ги во Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myKeys() {
      return ['p_' + me().get('phoneHash', '-'), 'e_' + me().get('emailHash', '-')];
    }

    function invitedTo(tripId) {
      return exists(/databases/$(database)/documents/invites/$(myKeys()[0])/trips/$(tripId))
          || exists(/databases/$(database)/documents/invites/$(myKeys()[1])/trips/$(tripId));
    }

    function memberOf(tripId) {
      return request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUIDs;
    }

    // Бројот во профилот е твој (клучот во /lookup е на твојот акаунт) или не е сменет.
    // Така ист број не може во два акаунта и никој не може да ги презема туѓите покани по број.
    function ownsPhoneHash() {
      let hash = request.resource.data.get('phoneHash', null);
      return hash == null
          || (resource != null && resource.data.get('phoneHash', null) == hash)
          || (exists(/databases/$(database)/documents/lookup/$('p_' + hash))
              && get(/databases/$(database)/documents/lookup/$('p_' + hash)).data.uid == request.auth.uid);
    }

    // Профил: име, бројот (за да се врати по повторна најава) и шифрираните клучеви.
    // Го чита само сопственикот — апликацијата никогаш не чита туѓи профили,
    // а правилата погоре (me()) го читаат преку get(), што не зависи од ова правило.
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && ownsPhoneHash();
    }

    // Лично: гардероба, аутфити, план по денови — само сопственикот
    match /users/{uid}/{collection}/{docId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Пребарување пријател по шифриран број/е-пошта — само по точен клуч, без листање
    match /lookup/{key} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Патувања: ги гледаат и менуваат само членовите
    match /trips/{tripId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUIDs;
      allow create: if signedIn() && request.resource.data.ownerUID == request.auth.uid;
      allow update: if signedIn() && (request.auth.uid in resource.data.memberUIDs || invitedTo(tripId));
      allow delete: if signedIn() && resource.data.ownerUID == request.auth.uid;
    }

    // Покани за луѓе што уште немаат акаунт
    match /invites/{key}/trips/{tripId} {
      allow read: if signedIn() && key in myKeys();
      allow create, update: if signedIn() && memberOf(tripId);
      allow delete: if signedIn() && (key in myKeys() || memberOf(tripId));
    }
  }
}
